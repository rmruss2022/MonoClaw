# EAS archives from the workspace root, so these paths are relative to
# open-home/, not to apps/mobile/. The first upload was 1.1 GB; almost all of
# it was the hoisted node_modules and hardware renders, none of which the
# build needs — EAS installs dependencies itself from the lockfile.

# Dependencies (409 MB). EAS runs its own install.
node_modules/
**/node_modules/

# Hardware renders, enclosure CAD and mockups (54 MB) — not shipped in the app.
hardware/
tv/

# Other services in the monorepo; the iOS build needs none of them.
services/
integrations/
packages/
scripts/

# The web control surface is served by the hub, not bundled here.
apps/app/

# Docs
*.md
!apps/mobile/README.md

# Build output and local state
.expo/
dist/
web-build/
ios/build/
android/
*.log
.DS_Store

# Signing material must never enter a build archive — it is referenced by
# absolute path from credentials.json and read locally by the CLI.
creds/
credentials/
credentials.json
*.p12
*.mobileprovision
