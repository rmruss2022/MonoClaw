# openhome content-router
PORT=8090
DATA_DIR=./data
# Shared with openhome-cloud + hub so the same account grant authorizes stick control
HOME_TOKEN_SECRET=

# --- Tier 1: search + deep links (makes it "act like a firestick") ---
TMDB_API_KEY=          # metadata (titles/posters/cast). free: themoviedb.org
WATCHMODE_API_KEY=     # availability + title-level Android deep links. watchmode.com

# --- Tier 2: real full-API integrations (search + play) ---
YOUTUBE_API_KEY=       # YouTube Data API
PLEX_URL=              # your Plex server, e.g. http://192.168.1.10:32400
PLEX_TOKEN=            # X-Plex-Token
JELLYFIN_URL=          # your Jellyfin server
JELLYFIN_TOKEN=        # Jellyfin API key
JELLYFIN_USER=         # Jellyfin user id
