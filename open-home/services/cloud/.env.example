# openhome-cloud configuration

# Where SQLite lives. On Railway, attach a Volume and set this to its mount path
# (e.g. /data) so accounts survive redeploys.
DATA_DIR=./data

# Port (Railway injects PORT automatically).
PORT=8080

# Shared secret used to sign home tokens. MUST match the hub's HOME_TOKEN_SECRET
# so hubs can verify the grants this service issues. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOME_TOKEN_SECRET=

# --- one-time seed (used by `npm run seed`, never committed) ---
SEED_EMAIL=
SEED_PASSWORD=
SEED_HOME_NAME=My home
SEED_HOME_ENDPOINT=home.bedrock.casa
