# Copy to /etc/openhome-voice.env and `chmod 600` it.
OPENHOME_HUB_URL=http://localhost:4700
ELEVENLABS_API_KEY=sk-...your-key...
# Rachel (calm). Pick any voice id from your ElevenLabs account.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Wake word. 'hey_jarvis' ships with openWakeWord. For a custom "Hey OpenHome",
# point this at a trained .onnx (see README).
OWW_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
SILENCE_MS=800

# Optional: pin the ReSpeaker if it isn't the default device.
# MIC_DEVICE=ReSpeaker
# SPK_DEVICE=ReSpeaker
